{
  "name": "duckduckgo-playwright-tests",
  "version": "1.0.0",
  "private": true,
  "description": "QA take-home: DuckDuckGo web (UI) and Instant Answer API tests with Playwright + TypeScript",
  "scripts": {
    "test": "playwright test",
    "test:web": "playwright test --project=chromium --project=firefox",
    "test:api": "playwright test --project=api",
    "test:headed": "playwright test --project=chromium --headed",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit"
  },
  "author": "Bautista Romero",
  "license": "UNLICENSED",
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "typescript": "^5.9.3"
  }
}
